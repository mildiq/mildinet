MILDINET_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/db_name
MILDINET_ENVIRONMENT=development
MILDINET_JWT_SECRET=replace-with-at-least-32-random-characters
MILDINET_JWT_ISSUER=mildinet
MILDINET_JWT_AUDIENCE=mildinet-web
MILDINET_ACCESS_TOKEN_TTL_MINUTES=15
MILDINET_REFRESH_TOKEN_TTL_DAYS=14
MILDINET_CORS_ORIGINS=["http://localhost:8000"]
MILDINET_COOKIE_SECURE=false
MILDINET_S3_ENDPOINT=http://localhost:9000
MILDINET_S3_ACCESS_KEY=minio
MILDINET_S3_SECRET_KEY=minio_password
MILDINET_S3_BUCKET=media